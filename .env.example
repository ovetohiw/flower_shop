# Host-dev: use localhost. Docker Compose sets DATABASE_URL to host `db` for the app service.
DATABASE_URL="postgresql://flower:flower@localhost:5432/flower_shop?schema=public"

# Required for Auth.js — set a long random string (Compose default is only for local docker)
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Public (browser)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""

# CDEK (optional — seed PVZ used when empty)
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
CDEK_API_URL="https://api.edu.cdek.ru/v2"

# YooKassa (optional — harness used when empty / YOOKASSA_MOCK=1)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_MOCK="1"
YOOKASSA_RETURN_URL="http://localhost:3000/checkout/result"

# Docker app only: run idempotent catalog seed on container start (1/0)
SEED_ON_START="1"
